<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal"
     xmlns:netfx="http://wixtoolset.org/schemas/v4/wxs/netfx">

  <!-- LiftUp-Setup-Server.exe: prüft die .NET-Desktop-Runtime und lädt sie bei
       Bedarf nach, bevor das MSI läuft. PostgreSQL wird bewusst nicht mitgeliefert,
       sondern beim Start des Einrichtungswerkzeugs in der neuesten Version geladen. -->
  <Bundle Name="LiftUp Server"
          Manufacturer="Lukas Sonderegger"
          Version="$(var.Version)"
          UpgradeCode="3F9A7B21-5D48-4E6C-8B07-2A4C6D9E1F58"
          IconSourceFile="$(var.IconPath)">

    <BootstrapperApplication>
      <bal:WixStandardBootstrapperApplication Theme="rtfLicense"
                                             LicenseFile="$(var.LicensePath)" />
    </BootstrapperApplication>

    <netfx:DotNetCoreSearch RuntimeType="desktop"
                            Platform="x64"
                            MajorVersion="8"
                            Variable="LiftUpServerDesktopRuntime8" />

    <Chain>
      <ExePackage Id="DotNetDesktopRuntime8"
                  SourceFile="$(var.DotNetInstaller)"
                  Name="windowsdesktop-runtime-8.0-win-x64.exe"
                  Description=".NET 8 Desktop Runtime"
                  DownloadUrl="https://builds.dotnet.microsoft.com/dotnet/WindowsDesktop/8.0.33/windowsdesktop-runtime-8.0.33-win-x64.exe"
                  Compressed="no"
                  InstallArguments="/install /quiet /norestart"
                  DetectCondition="LiftUpServerDesktopRuntime8 &gt;= v8.0.0"
                  InstallCondition="NOT (LiftUpServerDesktopRuntime8 &gt;= v8.0.0)"
                  PerMachine="yes"
                  Permanent="yes"
                  Vital="yes">
        <ExitCode Value="3010" Behavior="scheduleReboot" />
      </ExePackage>

      <MsiPackage Id="LiftUpServerMsi" SourceFile="$(var.MsiPath)" Vital="yes" />
    </Chain>
  </Bundle>
</Wix>
