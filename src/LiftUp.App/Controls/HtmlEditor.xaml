<UserControl x:Class="LiftUp.App.Controls.HtmlEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <UserControl.Resources>
        <Style x:Key="HtmlToolbarButton" TargetType="Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,4" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- KI über dem Text: Aktion wählen, Vorschlag im Vergleichsfenster prüfen. -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="KI" Style="{StaticResource LiftUpFieldLabel}"
                       VerticalAlignment="Center" Margin="0,0,6,0" />
            <ComboBox x:Name="AiActionBox" Width="190"
                      SelectionChanged="OnAiActionSelected"
                      ToolTip="Text an die verbundene KI geben: korrigieren, professioneller, kürzen oder verlängern" />
            <TextBlock x:Name="AiHintText" Style="{StaticResource LiftUpMutedText}"
                       VerticalAlignment="Center" Margin="8,0,0,0"
                       Text="Vorschlag wird vor dem Übernehmen angezeigt" />
        </StackPanel>

        <WrapPanel x:Name="ToolbarPanel" Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,6">
            <Button Content="Fett" FontWeight="Bold" Style="{StaticResource HtmlToolbarButton}" Click="OnBoldClick" ToolTip="Fett (Strg+B)" />
            <Button Content="Kursiv" FontStyle="Italic" Style="{StaticResource HtmlToolbarButton}" Click="OnItalicClick" ToolTip="Kursiv (Strg+I)" />
            <Button Style="{StaticResource HtmlToolbarButton}" Click="OnUnderlineClick" ToolTip="Unterstrichen (Strg+U)">
                <Button.Content>
                    <TextBlock TextDecorations="Underline">Unterstrichen</TextBlock>
                </Button.Content>
            </Button>
            <Button Content="Aufzählung" Style="{StaticResource HtmlToolbarButton}" Click="OnBulletListClick" ToolTip="Liste mit Punkten" />
            <Button Content="Nummerierung" Style="{StaticResource HtmlToolbarButton}" Click="OnNumberedListClick" ToolTip="Nummerierte Liste" />
            <Button Content="Formatierung entfernen" Style="{StaticResource HtmlToolbarButton}" Click="OnClearFormatClick"
                    ToolTip="Fett, Kursiv und Unterstrichen im markierten Text aufheben" />
            <Button x:Name="InsertImageButton" Content="Bild einfügen …" Style="{StaticResource HtmlToolbarButton}"
                    IsEnabled="False" Click="OnInsertImageClick"
                    ToolTip="Bild auswählen; liegt es nicht im Projektordner, wird es dort gespeichert und in den Text gesetzt" />
            <Button x:Name="SaveSnippetButton" Content="Als Textvorlage speichern" Style="{StaticResource HtmlToolbarButton}"
                    IsEnabled="False" Click="OnSaveSnippetClick"
                    ToolTip="Markierten Text als Textvorlage ablegen; Name und Kategorie werden abgefragt" />
        </WrapPanel>

        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource LiftUpBorder}" BorderThickness="1" CornerRadius="4">
            <Grid>
                <wv2:WebView2 x:Name="Browser" />
                <TextBox x:Name="FallbackBox"
                         Visibility="Collapsed"
                         AcceptsReturn="True"
                         AcceptsTab="True"
                         TextWrapping="NoWrap"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0" />
            </Grid>
        </Border>

        <!-- Vorschläge der „/“- und „&“-Suche: ein eigenes Fenster über dem Editor,
             damit die Liste nicht am Textfeld abgeschnitten wird. -->
        <Popup x:Name="SnippetPopup"
               AllowsTransparency="True"
               Focusable="False"
               Placement="Relative"
               PopupAnimation="Fade"
               StaysOpen="True">
            <Border Background="White"
                    BorderBrush="{StaticResource LiftUpBorder}"
                    BorderThickness="1"
                    CornerRadius="6"
                    MaxWidth="420"
                    MinWidth="260"
                    Padding="4">
                <ScrollViewer MaxHeight="320"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SnippetList" />
                </ScrollViewer>
            </Border>
        </Popup>
    </Grid>
</UserControl>
