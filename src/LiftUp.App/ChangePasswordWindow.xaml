<Window x:Class="LiftUp.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort ändern"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Text="Passwort ändern" Style="{StaticResource LiftUpSubheading}" />
            <TextBlock x:Name="HintText" Style="{StaticResource LiftUpMutedText}" Margin="0,4,0,14" />

            <TextBlock Text="Aktuelles Passwort" Style="{StaticResource LiftUpFieldLabel}" />
            <PasswordBox x:Name="CurrentInput" Margin="0,0,0,10" />

            <TextBlock Text="Neues Passwort" Style="{StaticResource LiftUpFieldLabel}" />
            <PasswordBox x:Name="NewInput" Margin="0,0,0,10" />

            <TextBlock Text="Neues Passwort wiederholen" Style="{StaticResource LiftUpFieldLabel}" />
            <PasswordBox x:Name="RepeatInput" Margin="0,0,0,8" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource LiftUpDanger}" TextWrapping="Wrap" MinHeight="32" FontSize="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                <Button x:Name="CancelButton" Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Speichern" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
