<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>LiftUp.App</RootNamespace>
    <AssemblyName>LiftUp.App</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('Assets\LiftUp.ico')">Assets\LiftUp.ico</ApplicationIcon>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiftUp.Core\LiftUp.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Auf Windows vorinstallierte WebView2-Engine: rendert HTML/CSS originalgetreu nach PDF. -->
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.*" />
  </ItemGroup>
</Project>
