<Window x:Class="LiftUp.App.Views.UserEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Benutzer"
        Width="520"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,14" />

            <TextBlock Text="Benutzername *" Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="UserNameBox" Margin="0,3,0,8" />

            <TextBlock Text="Anzeigename" Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="DisplayNameBox" Margin="0,3,0,8" />

            <TextBlock Text="Firma" Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="CompanyBox" Margin="0,3,0,8" ToolTip="Eigene Firma für Titelseiten" />

            <TextBlock Text="Straße, Hausnr." Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="CompanyStreetBox" Margin="0,3,0,8" ToolTip="Anschrift der eigenen Firma" />

            <TextBlock Text="PLZ, Ort" Style="{StaticResource LiftUpFieldLabel}" />
            <Grid Margin="0,3,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="90" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="CompanyZipBox" ToolTip="Postleitzahl" />
                <TextBox Grid.Column="1" x:Name="CompanyCityBox" Margin="8,0,0,0" ToolTip="Ort" />
            </Grid>

            <TextBlock Text="Firmenlogo" Style="{StaticResource LiftUpFieldLabel}" />
            <Grid Margin="0,3,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" x:Name="CompanyLogoBox"
                         ToolTip="Logo für Titelseiten; wird beim Speichern in den Logoordner kopiert" />
                <Button Grid.Column="1" Content="Logo wählen …" Margin="8,0,0,0" Click="OnBrowseLogoClick" />
            </Grid>

            <TextBlock Text="E-Mail" Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="EmailBox" Margin="0,3,0,8" ToolTip="Eigene E-Mail-Adresse für Titelseiten" />

            <TextBlock Text="Telefon" Style="{StaticResource LiftUpFieldLabel}" />
            <TextBox x:Name="PhoneBox" Margin="0,3,0,8" ToolTip="Eigene Telefonnummer für Titelseiten" />

            <TextBlock Text="Rolle" Style="{StaticResource LiftUpFieldLabel}" />
            <ComboBox x:Name="RoleBox" Margin="0,3,0,8" DisplayMemberPath="Name" />

            <CheckBox x:Name="ActiveCheck" Content="Konto ist aktiv" IsChecked="True" Margin="0,4,0,8" />

            <StackPanel x:Name="PasswordPanel">
                <TextBlock Text="Passwort *" Style="{StaticResource LiftUpFieldLabel}" />
                <PasswordBox x:Name="PasswordInput" Margin="0,3,0,8" />

                <TextBlock Text="Passwort wiederholen *" Style="{StaticResource LiftUpFieldLabel}" />
                <PasswordBox x:Name="RepeatInput" Margin="0,3,0,8" />

                <CheckBox x:Name="MustChangeCheck" Content="Benutzer muss das Passwort bei der ersten Anmeldung ändern"
                          IsChecked="True" Margin="0,0,0,6" />
            </StackPanel>

            <TextBlock x:Name="HintText" Style="{StaticResource LiftUpMutedText}" Margin="0,4,0,0" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource LiftUpDanger}" TextWrapping="Wrap" MinHeight="30" FontSize="12" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Speichern" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
