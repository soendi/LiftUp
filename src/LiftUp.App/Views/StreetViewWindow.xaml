<Window x:Class="LiftUp.App.Views.StreetViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Google Street View"
        Width="1400"
        Height="900"
        WindowState="Maximized"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <!-- Die Leiste steht als eigene Zeile über dem Browser: WPF-Elemente können den
         eingebetteten Browser nicht überdecken, sie wären sonst unsichtbar. -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource LiftUpSurface}"
                BorderBrush="{StaticResource LiftUpBorder}"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Straßenansicht:" Style="{StaticResource LiftUpFieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock x:Name="AddressText" FontWeight="SemiBold" VerticalAlignment="Center"
                               Foreground="{StaticResource LiftUpHeader}" MaxWidth="520"
                               TextTrimming="CharacterEllipsis" />
                    <Button x:Name="CaptureButton" Content="Foto aufnehmen" Margin="18,0,8,0"
                            Style="{StaticResource LiftUpPrimaryButton}" Click="OnCaptureClick" />
                    <Button Content="Neu laden" Click="OnReloadClick" />
                    <Button Content="Abbrechen" Margin="0" Click="OnCancelClick" />
                </StackPanel>
                <TextBlock x:Name="HintText" Style="{StaticResource LiftUpMutedText}" Margin="0,8,0,0"
                           Text="Straßenansicht wird geladen …" />
            </StackPanel>
        </Border>

        <wv2:WebView2 Grid.Row="1" x:Name="Browser" />
    </Grid>
</Window>
