<Window x:Class="LiftUp.App.Views.ImagePropertiesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilder importieren"
        Width="820"
        Height="520"
        MinWidth="640"
        MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,8"
                       Text="Pro Bild Name, Kategorie und Schlagworte festlegen. Mehrere Schlagworte mit Komma trennen, z. B. „logo, grundriss, rot“. Später über „Bearbeiten …“ änderbar." />

            <DataGrid x:Name="RowsGrid" Grid.Row="2"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="200" IsReadOnly="True" />
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="160" />
                    <DataGridTextColumn Header="Schlagworte" Binding="{Binding Tags}" Width="220" />
                </DataGrid.Columns>
            </DataGrid>

            <Grid Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="HintText" Style="{StaticResource LiftUpMutedText}" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Abbrechen" Click="OnCancelClick" />
                    <Button x:Name="ConfirmButton" Content="Importieren" IsDefault="True"
                            Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnConfirmClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
