<Window x:Class="LiftUp.App.Views.ReplaceImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bilder ersetzen"
        Width="740"
        Height="440"
        MinWidth="600"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LiftUpSubheading}" Text="Bilder ersetzen" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Die gewählten Dateien werden unter demselben Namen in die globale Bildbibliothek übernommen, damit die Platzhalter in der Vorlage wieder passen. Für Projektbilder gilt weiterhin das Projekt selbst." />

            <ListBox x:Name="RowsList" Grid.Row="2" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                       Style="{StaticResource LiftUpMutedText}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding}"
                                    Click="OnChooseFileClick" Margin="0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="HintText" Grid.Row="3" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Ersetzen" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}"
                        Margin="0" Click="OnApplyClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
