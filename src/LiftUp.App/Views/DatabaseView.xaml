<UserControl x:Class="LiftUp.App.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Zentrale Datenbank (PostgreSQL)"
                           FontSize="16"
                           FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0"
                           Text="Hier stehen die Zugangsdaten des Datenbankservers. Sie kommen aus der Datei, die das LiftUp-Server-Setup auf dem Server erzeugt (Standardname LiftUp-Datenbank-Zugang.json), und lassen sich hier einlesen. Ohne Eintrag arbeitet LiftUp rein lokal." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="HostBox" Margin="0,0,16,8" />

                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="0" Grid.Column="3" x:Name="PortBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datenbank"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="DatabaseNameBox" Margin="0,0,16,8" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="Benutzer"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,8" />
                <TextBox Grid.Row="1" Grid.Column="3" x:Name="UserBox" Margin="0,0,0,8" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Passwort"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="PasswordBox" Margin="0,0,16,0" />

                <TextBlock Grid.Row="2" Grid.Column="2" Text="SSL-Modus"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <ComboBox Grid.Row="2" Grid.Column="3" x:Name="SslBox" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <WrapPanel Orientation="Horizontal">
                    <Button Content="Datei einlesen …" Click="OnImportClick" Margin="0,0,8,8" />
                    <Button Content="Verbindung testen" Click="OnTestClick" Margin="0,0,8,8" />
                    <Button Content="Speichern" Click="OnSaveClick" Margin="0,0,8,8" />
                    <Button Content="Jetzt synchronisieren"
                            Style="{StaticResource LiftUpPrimaryButton}"
                            Click="OnSyncClick"
                            Margin="0,0,8,8" />
                </WrapPanel>

                <TextBlock x:Name="InfoText"
                           Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,2,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Google Street View" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,10"
                           Text="Ohne Schlüssel löst Google die Adresse selbst auf – dort kann ein privat hochgeladenes Panorama erscheinen. Mit einem Google-Maps-Schlüssel fragt LiftUp die amtlichen Aufnahmen ab («source=google») und öffnet genau diese. Die Metadaten-Abfragen sind bei Google kostenlos." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="API-Schlüssel"
                               Style="{StaticResource LiftUpFieldLabel}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <PasswordBox Grid.Column="1" x:Name="StreetViewKeyBox" Margin="0,0,8,0" />
                    <Button Grid.Column="2" Content="Speichern" Click="OnSaveStreetViewKeyClick" />
                </Grid>
                <TextBlock x:Name="StreetViewKeyHint"
                           Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="4" Style="{StaticResource LiftUpCard}" Padding="12" VerticalAlignment="Top">
            <StackPanel>
                <TextBlock Text="Zustand" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="StateText" TextWrapping="Wrap" />
                <TextBlock x:Name="PendingText" Style="{StaticResource LiftUpMutedText}" Margin="0,8,0,0" />
                <TextBlock x:Name="LastRunText" Style="{StaticResource LiftUpMutedText}" Margin="0,2,0,0" />
                <TextBlock x:Name="DeviceText" Style="{StaticResource LiftUpMutedText}" Margin="0,2,0,0" />
                <TextBlock Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,10,0,0"
                           Text="Abgeglichen werden Projekte, Benutzer, Rollen, Vorlagen, Textbausteine und Dokumenttypen. Erzeugte PDFs und Bilder bleiben am jeweiligen Arbeitsplatz, weil dort auch die Dateien liegen. Die Synchronisierung läuft beim Start, alle fünf Minuten und vor dem Schließen der Anwendung." />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
