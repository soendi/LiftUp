<UserControl x:Class="LiftUp.App.Views.DatabaseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Verbindungsdatei der Server-Datenbank"
                           Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="PathBox" Width="360" Margin="0,0,8,0" />
                    <Button Content="Datei wählen …" Click="OnBrowseClick" />
                    <Button x:Name="ImportButton" Content="Einlesen"
                            Style="{StaticResource LiftUpPrimaryButton}" Click="OnImportClick" />
                    <Button x:Name="TestButton" Content="Verbindung prüfen" Click="OnTestClick" />
                    <Button x:Name="RemoveButton" Content="Einstellungen entfernen" Click="OnRemoveClick" Margin="0" />
                </StackPanel>

                <TextBlock Style="{StaticResource LiftUpMutedText}" Margin="0,8,0,0"
                           Text="liftup-server.json entsteht auf dem Datenbank-Server mit installer/Install-ServerDatabase.ps1 und enthält Server, Port, Datenbank, Schema und die Zugangsdaten. Nach dem Einlesen merkt sich LiftUp die Angaben in der lokalen Datenbank; das Passwort liegt unter Windows DPAPI-geschützt." />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Server"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="ServerText" Grid.Row="0" Grid.Column="1" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Grid.Row="0" Grid.Column="2" Text="Port"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="PortText" Grid.Row="0" Grid.Column="3" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Datenbank"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="DatabaseText" Grid.Row="1" Grid.Column="1" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Grid.Row="1" Grid.Column="2" Text="Schema"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="SchemaText" Grid.Row="1" Grid.Column="3" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Benutzer"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="UserText" Grid.Row="2" Grid.Column="1" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Grid.Row="2" Grid.Column="2" Text="Passwort"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBlock x:Name="PasswordText" Text="—" Foreground="{StaticResource LiftUpHeader}"
                               VerticalAlignment="Center" />
                    <CheckBox x:Name="ShowPasswordCheck" Content="anzeigen" Margin="10,0,0,0"
                              VerticalAlignment="Center" Checked="OnShowPasswordChanged"
                              Unchecked="OnShowPasswordChanged" />
                </StackPanel>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="SSL-Modus"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="SslText" Grid.Row="3" Grid.Column="1" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Grid.Row="3" Grid.Column="2" Text="Serverversion"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="ServerVersionText" Grid.Row="3" Grid.Column="3" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Schemastand"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="SchemaVersionText" Grid.Row="4" Grid.Column="1" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />
                <TextBlock Grid.Row="4" Grid.Column="2" Text="Datei erstellt"
                           Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                <TextBlock x:Name="GeneratedText" Grid.Row="4" Grid.Column="3" Text="—"
                           Foreground="{StaticResource LiftUpHeader}" VerticalAlignment="Center" Margin="0,0,0,6" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Quelle"
                           Style="{StaticResource LiftUpFieldLabel}" />
                <TextBlock x:Name="SourceText" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="3" Text="—"
                           Foreground="{StaticResource LiftUpMuted}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Abgleich mit dem Server"
                           Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,8" />

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="SyncButton" Content="Jetzt abgleichen" Margin="0,0,10,0"
                            Style="{StaticResource LiftUpPrimaryButton}" Click="OnSyncClick" />
                    <TextBlock x:Name="SyncStatusText" Text="—" VerticalAlignment="Center"
                               Foreground="{StaticResource LiftUpHeader}" TextWrapping="Wrap" />
                </StackPanel>

                <TextBlock Style="{StaticResource LiftUpMutedText}" Margin="0,8,0,0"
                           Text="Überträgt die offenen Einträge des Änderungsprotokolls an den Server und übernimmt die Einträge der anderen Arbeitsplätze. Übertragen wird, was sich geändert hat – die Feldinhalte selbst bleiben in der jeweiligen lokalen Datenbank." />
            </StackPanel>
        </Border>

        <Border Grid.Row="3" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock x:Name="TablesHeading" Text="Tabellen im Schema"
                           Style="{StaticResource LiftUpFieldLabel}" />
                <ListBox x:Name="TablesList" Grid.Row="1" Margin="0,6,0,0" BorderThickness="0" />
            </Grid>
        </Border>

        <TextBlock x:Name="InfoText" Grid.Row="4" Style="{StaticResource LiftUpMutedText}" Margin="2,0,0,0" />
    </Grid>
</UserControl>
