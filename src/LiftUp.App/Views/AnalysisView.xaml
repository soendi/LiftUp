<UserControl x:Class="LiftUp.App.Views.AnalysisView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Projekt" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="ProjectBox" Width="260" DisplayMemberPath="DisplayText"
                              SelectionChanged="OnProjectChanged" />
                </StackPanel>

                <TextBlock Grid.Column="1" Margin="16,0" VerticalAlignment="Center" TextWrapping="Wrap"
                           Style="{StaticResource LiftUpMutedText}"
                           Text="Die Texte gelten für das ganze Projekt. Sie erscheinen im PDF über {{analyse}} und belegen beim Erstellen eines Dokuments den Reiter „2. Analyse“ vor. Im Text mit /Textbaustein, &amp;Bild (&amp;Bild im Projekt, &amp;&amp;Bild auch global) und //Feld (Werte aus der Zustandsanalyse) suchen. Nicht gespeicherte Änderungen gehen beim Projektwechsel verloren." />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Neu laden" Click="OnReloadClick" />
                    <Button Content="Speichern" Style="{StaticResource LiftUpPrimaryButton}" Margin="0"
                            Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="ChapterTabs" Grid.Row="1" />

        <TextBlock x:Name="InfoText" Grid.Row="2" Style="{StaticResource LiftUpMutedText}" Margin="2,8,0,0" />
    </Grid>
</UserControl>
