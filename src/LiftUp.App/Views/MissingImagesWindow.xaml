<Window x:Class="LiftUp.App.Views.MissingImagesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fehlende Bilder"
        Width="760"
        Height="480"
        MinWidth="620"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LiftUpSubheading}"
                       Text="Bilder fehlen" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Diese Bilder aus der Vorlage sind nicht mehr vorhanden. Wähle je Bild eine Datei aus – sie wird unter demselben Namen in die Bibliothek übernommen, damit der Platzhalter wieder passt. Alternativ lassen sich die Platzhalter aus der Vorlage entfernen." />

            <ListBox x:Name="RowsList" Grid.Row="2" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                       Style="{StaticResource LiftUpMutedText}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding}"
                                    Click="OnChooseFileClick" Margin="0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="HintText" Grid.Row="3" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Platzhalter entfernen …" Click="OnRemovePlaceholdersClick" />
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button x:Name="ApplyButton" Content="Ersetzen" IsDefault="True"
                        Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnApplyClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
