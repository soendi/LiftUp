<Window x:Class="LiftUp.App.Views.ImageCropWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Foto zuschneiden"
        Height="760"
        Width="1040"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" x:Name="HintText" Style="{StaticResource LiftUpMutedText}" Margin="0,0,0,10"
                   Text="Ausschnitt mit der Maus im Bild aufziehen. Ohne Auswahl wird das ganze Foto übernommen." />

        <Border Grid.Row="1" Background="#20262E" CornerRadius="4" ClipToBounds="True">
            <Grid x:Name="Stage" ClipToBounds="True">
                <Image x:Name="Photo" Stretch="Fill" HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Grid x:Name="Overlay" Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <Canvas x:Name="SelectionLayer" IsHitTestVisible="False">
                        <Rectangle x:Name="SelectionRect" Stroke="#FFD34A" StrokeThickness="2"
                                   StrokeDashArray="4 3" Fill="#33FFFFFF" Visibility="Collapsed" />
                    </Canvas>
                </Grid>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="Abbrechen" Click="OnCancelClick" />
            <Button Content="Übernehmen" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnOkClick" />
        </StackPanel>
    </Grid>
</Window>
