<Window x:Class="LiftUp.App.Views.MissingPlaceholdersWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fehlende Angaben"
        Width="780"
        Height="560"
        MinWidth="620"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LiftUpSubheading}"
                       Text="Angaben fehlen" Margin="0,0,0,6" />

            <TextBlock Grid.Row="1" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                       Text="Diese Angaben aus der Vorlage sind nicht mehr vorhanden. Bilder lassen sich direkt ersetzen: die gewählte Datei wird unter demselben Namen in die Bibliothek übernommen, damit der Platzhalter wieder passt. Alternativ lassen sich alle fehlenden Platzhalter aus der Vorlage entfernen." />

            <TextBlock x:Name="ImagesHeader" Grid.Row="2" FontWeight="SemiBold" Text="Fehlende Bilder" Margin="0,0,0,4" />

            <ListBox x:Name="ImagesList" Grid.Row="3" MaxHeight="150" HorizontalContentAlignment="Stretch">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{Binding Status}"
                                       Style="{StaticResource LiftUpMutedText}" TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" Margin="8,0" />
                            <Button Grid.Column="2" Content="{Binding ButtonText}" Tag="{Binding}"
                                    Click="OnChooseFileClick" Margin="0" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="SnippetsHeader" Grid.Row="4" FontWeight="SemiBold" Text="Fehlende Textbausteine"
                       Margin="0,10,0,4" />

            <ListBox x:Name="SnippetsList" Grid.Row="5" MaxHeight="120">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" FontWeight="SemiBold" Margin="0,2" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="SnippetsHint" Grid.Row="6" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" Margin="0,4,0,0"
                       Text="Textbausteine lassen sich in der Textbausteinansicht anlegen; der Name muss dem Platzhalter entsprechen." />

            <TextBlock x:Name="HintText" Grid.Row="7" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" Margin="0,8,0,0" />

            <StackPanel Grid.Row="7" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Platzhalter entfernen …" Click="OnRemovePlaceholdersClick" />
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button x:Name="ApplyButton" Content="Ersetzen" IsDefault="True"
                        Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnApplyClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
