<Window x:Class="LiftUp.App.Views.ProjectEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Projekt"
        Width="1680"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,14" />

            <!-- Links die bisherigen Angaben, rechts die Meilensteine. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="28" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Projektname *" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="NameBox" Margin="0,3,0,8" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Projektnummer" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="NumberBox" Margin="0,3,0,8" ToolTip="Leer lassen für automatische Vergabe (z. B. 2026-0001)" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Verantwortlich" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="2" Grid.Column="1" x:Name="ResponsibleBox" Margin="0,3,0,8"
                          DisplayMemberPath="Name" SelectedValuePath="Id" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <ComboBox Grid.Row="3" Grid.Column="1" x:Name="StatusBox" Margin="0,3,0,8" DisplayMemberPath="Name" SelectedValuePath="Value" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Beschreibung" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0" />
                <TextBox Grid.Row="4" Grid.Column="1" x:Name="DescriptionBox" Height="64" Margin="0,3,0,8"
                         AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Projektordner *" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <Grid Grid.Row="5" Grid.Column="1" Margin="0,3,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="FolderBox" />
                    <Button Grid.Column="1" Content="Ordner wählen …" Margin="8,0,0,0" Click="OnBrowseClick" />
                </Grid>

                <TextBlock Grid.Row="6" Grid.Column="0" Text="Projektbild" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                <Grid Grid.Row="6" Grid.Column="1" Margin="0,3,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" x:Name="ImageBox"
                             ToolTip="Bild für das Deckblatt; wird beim Speichern in den Projektordner kopiert" />
                    <Button Grid.Column="1" Content="Bild wählen …" Margin="8,0,0,0" Click="OnBrowseImageClick" />
                    <Button Grid.Column="2" Content="Google Street View" Margin="8,0,0,0" Click="OnStreetViewClick"
                            ToolTip="Straßenansicht zur Projektadresse im Vollbild öffnen, Foto aufnehmen, zuschneiden und als Projektbild übernehmen" />
                </Grid>

                <CheckBox Grid.Row="7" Grid.Column="1"
                          x:Name="CreateFolderCheck"
                          Content="Ordner samt Unterordnern anlegen, falls er nicht existiert"
                          IsChecked="True"
                          Margin="0,2,0,2" />

                <TextBlock Grid.Row="8" Grid.Column="1" Style="{StaticResource LiftUpMutedText}"
                           Text="Beliebiger Pfad auf jedem Laufwerk, z. B. D:\Projekte\Neubau." />

                <Border Grid.Row="9" Grid.ColumnSpan="2" Height="1" Background="{StaticResource LiftUpBorder}" Margin="0,12,0,14" />

                <!-- Zwei Anschriften nebeneinander: Kunde und Auftraggeber. -->
                <TabControl Grid.Row="10" Grid.ColumnSpan="2" Margin="0,0,0,4">
                    <TabItem Header="Projekt">
                        <Grid Margin="12,10,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Kunde" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="CustomerBox" Margin="0,3,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Straße, Hausnr." Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="StreetBox" Margin="0,3,0,8" ToolTip="Anschrift des Kunden" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zusatz" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="AddressLine2Box" Margin="0,3,0,8"
                                     ToolTip="Zweite Adresszeile, z. B. Gebäude, Abteilung oder Postfach" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PLZ, Ort" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,3,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ZipBox" ToolTip="Postleitzahl" />
                                <TextBox Grid.Column="1" x:Name="CityBox" Margin="8,0,0,0" ToolTip="Ort" />
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ansprechpersonen"
                                       Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <DataGrid Grid.Row="4" Grid.Column="1"
                                      x:Name="ContactsGrid"
                                      Height="128"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                    <DataGridTextColumn Header="Zuständigkeit" Binding="{Binding Responsibility, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Person hinzufügen" Click="OnAddContactClick" />
                                <Button Content="Zeile entfernen" Click="OnRemoveContactClick" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                    <TabItem Header="Auftraggeber">
                        <Grid Margin="12,10,12,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Auftraggeber" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="0" Grid.Column="1" x:Name="ClientBox" Margin="0,3,0,8" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Straße, Hausnr." Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" x:Name="ClientStreetBox" Margin="0,3,0,8" ToolTip="Anschrift des Auftraggebers" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Zusatz" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" x:Name="ClientLine2Box" Margin="0,3,0,8"
                                     ToolTip="Zweite Adresszeile, z. B. Gebäude, Abteilung oder Postfach" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="PLZ, Ort" Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Center" />
                            <Grid Grid.Row="3" Grid.Column="1" Margin="0,3,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" x:Name="ClientZipBox" ToolTip="Postleitzahl" />
                                <TextBox Grid.Column="1" x:Name="ClientCityBox" Margin="8,0,0,0" ToolTip="Ort" />
                            </Grid>

                            <TextBlock Grid.Row="4" Grid.Column="0" Text="Ansprechpersonen"
                                       Style="{StaticResource LiftUpFieldLabel}" VerticalAlignment="Top" Margin="0,7,0,0" TextWrapping="Wrap" />
                            <DataGrid Grid.Row="4" Grid.Column="1"
                                      x:Name="ClientContactsGrid"
                                      Height="128"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserReorderColumns="False"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      SelectionMode="Single"
                                      RowHeight="26">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                                    <DataGridTextColumn Header="E-Mail" Binding="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                                    <DataGridTextColumn Header="Telefon" Binding="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Width="120" />
                                    <DataGridTextColumn Header="Zuständigkeit" Binding="{Binding Responsibility, UpdateSourceTrigger=PropertyChanged}" Width="140" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Margin="0,6,0,0">
                                <Button Content="Person hinzufügen" Click="OnAddClientContactClick" />
                                <Button Content="Zeile entfernen" Click="OnRemoveClientContactClick" />
                            </StackPanel>
                        </Grid>
                    </TabItem>

                </TabControl>
                </Grid>

                <!-- Rechte Seite: Meilensteine des Projekts. -->
                <Grid Grid.Column="2" VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Meilensteine" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,6" />

                    <TextBlock Grid.Row="1" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,10"
                               Text="„Begehung“ ist fest vorgegeben, liefert das Datum für das Deckblatt und lässt sich nur abhaken. Weitere Meilensteine sind frei: hinzufügen, ändern, löschen, abhaken mit Datum." />

                    <DataGrid Grid.Row="2"
                              x:Name="MilestonesGrid"
                              Height="320"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              CanUserReorderColumns="False"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              SelectionMode="Single"
                              RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Meilenstein" Binding="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Width="*" />
                            <DataGridCheckBoxColumn Header="Erledigt" Binding="{Binding IsDone, UpdateSourceTrigger=PropertyChanged}" Width="80" />
                            <DataGridTextColumn Header="Datum (TT.MM.JJJJ)" Binding="{Binding DoneDateText, UpdateSourceTrigger=PropertyChanged}" Width="150" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                        <Button Content="Meilenstein hinzufügen" Click="OnAddMilestoneClick" />
                        <Button Content="Zeile entfernen" Click="OnRemoveMilestoneClick" />
                    </StackPanel>
                </Grid>
            </Grid>

            <TextBlock x:Name="ArchiveInfoText" Style="{StaticResource LiftUpMutedText}" Margin="0,10,0,0" Visibility="Collapsed" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource LiftUpDanger}" TextWrapping="Wrap" MinHeight="32" FontSize="12" Margin="0,8,0,0" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Speichern" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
