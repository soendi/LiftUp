<UserControl x:Class="LiftUp.App.Views.EmergencyAdminView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Notfall-Wiederherstellung" Style="{StaticResource LiftUpSubheading}" />
                <TextBlock Style="{StaticResource LiftUpMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Text="Der Notfallzugang wurde mit einem gültigen MasterKey-Lizenzcode geöffnet. Hier lassen sich Passwörter neu setzen und gesperrte Konten wieder freigeben. Benutzerkonten werden dabei weder gelöscht noch verändert – nur der Zugang wird wiederhergestellt." />
                <TextBlock x:Name="SessionText" Style="{StaticResource LiftUpMutedText}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <DataGrid x:Name="UsersGrid" Grid.Row="1" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Benutzername" Binding="{Binding UserName}" Width="150" />
                <DataGridTextColumn Header="Anzeigename" Binding="{Binding DisplayName}" Width="170" />
                <DataGridTextColumn Header="Rolle" Binding="{Binding RoleName}" Width="140" />
                <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                <DataGridTextColumn Header="Letzte Anmeldung" Binding="{Binding LastLoginText}" Width="150" />
                <DataGridTextColumn Header="Rechte" Binding="{Binding PermissionSummary}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,10,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Passwort zurücksetzen" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBlock Text="Gilt für den in der Liste gewählten Benutzer – auch für das Administratorkonto."
                               Style="{StaticResource LiftUpMutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Neues Passwort" Style="{StaticResource LiftUpFieldLabel}" />
                    <PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,8" />
                    <TextBlock Text="Neues Passwort wiederholen" Style="{StaticResource LiftUpFieldLabel}" />
                    <PasswordBox x:Name="RepeatPasswordBox" Margin="0,0,0,10" />
                    <Button Content="Passwort speichern"
                            Style="{StaticResource LiftUpPrimaryButton}"
                            HorizontalAlignment="Left"
                            Click="OnResetPasswordClick" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="Konto entsperren" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBlock Text="Ein deaktiviertes Konto wird wieder zugelassen; Daten bleiben unverändert."
                               Style="{StaticResource LiftUpMutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <Button Content="Konto entsperren"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            Click="OnUnlockClick" />

                    <TextBlock Text="Neuer Administrator" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBlock Text="Falls kein Administratorkonto mehr erreichbar ist."
                               Style="{StaticResource LiftUpMutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8" />
                    <TextBlock Text="Benutzername" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBox x:Name="NewAdminNameBox" Margin="0,0,0,8" />
                    <TextBlock Text="Passwort" Style="{StaticResource LiftUpFieldLabel}" />
                    <PasswordBox x:Name="NewAdminPasswordBox" Margin="0,0,0,8" />
                    <TextBlock Text="Passwort wiederholen" Style="{StaticResource LiftUpFieldLabel}" />
                    <PasswordBox x:Name="NewAdminRepeatBox" Margin="0,0,0,10" />
                    <Button Content="Administrator anlegen"
                            HorizontalAlignment="Left"
                            Click="OnCreateAdminClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="3" Margin="0,10,0,0">
            <TextBlock x:Name="StatusText" Style="{StaticResource LiftUpMutedText}" VerticalAlignment="Center" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                <TextBlock Text="Abmeldung nach Inaktivität (Minuten)"
                           Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center"
                           Margin="0,0,6,0" />
                <TextBox x:Name="TimeoutBox" Width="52" LostFocus="OnTimeoutChanged" />
                <Button Content="Notfallzugang beenden"
                        Style="{StaticResource LiftUpDangerButton}"
                        Margin="12,0,0,0"
                        Click="OnEndClick" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
