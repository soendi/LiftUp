<UserControl x:Class="LiftUp.App.Views.ChangeLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="10" Margin="0,0,0,10">
            <WrapPanel Orientation="Horizontal">
                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Bereich" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="EntityBox" Width="150" SelectionChanged="OnFilterChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Bearbeiter" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="ActorBox" Width="150" SelectionChanged="OnFilterChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Von" Style="{StaticResource LiftUpFieldLabel}" />
                    <DatePicker x:Name="FromPicker" Width="130" SelectedDateChanged="OnDateChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Bis" Style="{StaticResource LiftUpFieldLabel}" />
                    <DatePicker x:Name="ToPicker" Width="130" SelectedDateChanged="OnDateChanged" />
                </StackPanel>

                <StackPanel Margin="0,0,12,0">
                    <TextBlock Text="Suche" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBox x:Name="SearchBox" Width="180" TextChanged="OnSearchChanged" />
                </StackPanel>

                <StackPanel VerticalAlignment="Bottom">
                    <Button Content="Aktualisieren" Click="OnRefreshClick" Width="120" />
                </StackPanel>
            </WrapPanel>
        </Border>

        <TextBlock Grid.Row="1" x:Name="InfoText" Margin="2,0,0,6" TextWrapping="Wrap" />

        <DataGrid Grid.Row="2" x:Name="LogGrid" IsReadOnly="True" SelectionChanged="OnSelected">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Zeit" Binding="{Binding ChangedText}" Width="130" />
                <DataGridTextColumn Header="Bearbeiter" Binding="{Binding ActorText}" Width="130" />
                <DataGridTextColumn Header="Bereich" Binding="{Binding EntityText}" Width="110" />
                <DataGridTextColumn Header="Vorgang" Binding="{Binding OperationText}" Width="150" />
                <DataGridTextColumn Header="Objekt" Binding="{Binding ObjectText}" Width="*" />
                <DataGridTextColumn Header="Gerät" Binding="{Binding DeviceText}" Width="120" />
                <DataGridTextColumn Header="Abgleich" Binding="{Binding SyncText}" Width="95" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="3" Style="{StaticResource LiftUpCard}" Padding="10" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="Details zum ausgewählten Eintrag" Style="{StaticResource LiftUpFieldLabel}"
                           Margin="0,0,0,6" />
                <TextBox x:Name="PayloadBox" IsReadOnly="True" Height="110" TextWrapping="Wrap"
                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
