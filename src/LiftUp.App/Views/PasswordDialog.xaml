<Window x:Class="LiftUp.App.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Passwort zurücksetzen"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <StackPanel>
            <TextBlock x:Name="HeadingText" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,12" />

            <TextBlock Text="Neues Passwort" Style="{StaticResource LiftUpFieldLabel}" />
            <PasswordBox x:Name="NewInput" Margin="0,3,0,8" />

            <TextBlock Text="Neues Passwort wiederholen" Style="{StaticResource LiftUpFieldLabel}" />
            <PasswordBox x:Name="RepeatInput" Margin="0,3,0,8" />

            <CheckBox x:Name="MustChangeCheck" Content="Benutzer muss das Passwort bei der nächsten Anmeldung ändern"
                      IsChecked="True" Margin="0,4,0,4" />

            <TextBlock x:Name="ErrorText" Foreground="{StaticResource LiftUpDanger}" TextWrapping="Wrap" MinHeight="30" FontSize="12" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Übernehmen" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveClick" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
