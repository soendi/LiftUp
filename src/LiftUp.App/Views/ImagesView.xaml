<UserControl x:Class="LiftUp.App.Views.ImagesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:LiftUp.App.Converters">

    <UserControl.Resources>
        <conv:TagActiveConverter x:Key="TagActiveConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Content="Bilder importieren …" Style="{StaticResource LiftUpPrimaryButton}"
                            Click="OnImportClick" />
                    <Button Content="Ordner einlesen" Click="OnScanFolderClick" />
                    <Button x:Name="RemoveMissingButton" Content="Fehlende entfernen" IsEnabled="False"
                            Click="OnRemoveMissingClick" Margin="0" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Bereich" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="ProjectBox" Width="230" Margin="0,0,12,0"
                              DisplayMemberPath="Name" SelectionChanged="OnProjectChanged" />

                    <TextBlock Text="Kategorie" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="CategoryFilterBox" Width="140" SelectionChanged="OnCategoryChanged" />

                    <TextBlock Text="Schlagworte" VerticalAlignment="Center" Margin="12,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <Button x:Name="TagFilterButton" Content="Alle" Width="140" Margin="0,0,12,0"
                            HorizontalContentAlignment="Left" Click="OnTagFilterClick"
                            ToolTip="Mehrere Schlagworte gleichzeitig wählen" />

                    <TextBlock Text="Suche" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBox x:Name="SearchBox" Width="150" TextChanged="OnSearchChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox x:Name="ArchiveToggle" Content="Archivierte anzeigen" Click="OnFilterChanged" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <DataGrid x:Name="ImagesGrid" Grid.Column="0" IsReadOnly="True" Margin="0,0,10,0"
                      SelectionMode="Extended" SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Kategorie" Binding="{Binding Category}" Width="130" />
                    <DataGridTemplateColumn Header="Schlagworte" Width="200">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding TagList}" VerticalAlignment="Center">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding}" Tag="{Binding}" Click="OnTagClick"
                                                    Margin="0,1,4,1" Padding="5,0" MinHeight="0"
                                                    Cursor="Hand" FontSize="11"
                                                    ToolTip="Nach diesem Schlagwort filtern (erneut klicken hebt es auf)">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Background" Value="#F4F6F9" />
                                                        <Setter Property="BorderBrush" Value="#C7D0DD" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="Foreground" Value="#1F2A44" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource TagActiveConverter}">
                                                                        <Binding />
                                                                        <Binding Path="ActiveTags" RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="Background" Value="#DCE9FF" />
                                                                <Setter Property="BorderBrush" Value="#2D6CDF" />
                                                                <Setter Property="FontWeight" Value="SemiBold" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Bereich" Binding="{Binding ScopeText}" Width="90" />
                    <DataGridTextColumn Header="Datei" Binding="{Binding FileStatusText}" Width="85">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FileExists}" Value="False">
                                        <Setter Property="Foreground" Value="#B42318" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>
                    <DataGridTextColumn Header="Größe" Binding="{Binding SizeText}" Width="90" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="90" />
                </DataGrid.Columns>
            </DataGrid>

            <Border Grid.Column="1" Style="{StaticResource LiftUpCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource LiftUpBorder}" BorderThickness="1">
                        <Image x:Name="PreviewImage" Stretch="Uniform" Margin="6" />
                    </Border>

                    <StackPanel Grid.Row="1" Margin="0,8,0,0">
                        <TextBlock x:Name="PlaceholderText" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                   Text="Diesen Baustein in eine Vorlage einsetzen – das Bild wird als Data-URI eingebettet. Im Dokumenteditor geht es auch direkt mit &amp;Name." />
                    </StackPanel>

                    <WrapPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="BulkTagsButton" Content="Schlagworte …" Click="OnBulkTagsClick" IsEnabled="False"
                                ToolTip="Schlagworte für alle markierten Bilder setzen oder entfernen" />
                        <Button x:Name="EditButton" Content="Bearbeiten …" Click="OnEditClick" IsEnabled="False" />
                        <Button x:Name="ArchiveButton" Content="Archivieren" Click="OnArchiveClick" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Löschen" Click="OnDeleteClick" IsEnabled="False" Margin="0" />
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="2" Style="{StaticResource LiftUpMutedText}" Margin="2,8,0,0" />

        <Popup x:Name="TagFilterPopup" PlacementTarget="{Binding ElementName=TagFilterButton}" Placement="Bottom"
               StaysOpen="False" AllowsTransparency="True">
            <Border Background="White" BorderBrush="{StaticResource LiftUpBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="6">
                <StackPanel Width="250">
                    <TextBox x:Name="TagSearchBox" Margin="0,0,0,4"
                             TextChanged="OnTagSearchChanged" PreviewKeyDown="OnTagSearchKeyDown"
                             ToolTip="Schlagworte eingrenzen" />
                    <TextBlock Text="Tippen grenzt die Liste ein, Enter wählt den ersten Treffer."
                               Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" Margin="0,0,0,6" />
                    <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="TagListPanel" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
