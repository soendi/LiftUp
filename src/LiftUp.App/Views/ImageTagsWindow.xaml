<Window x:Class="LiftUp.App.Views.ImageTagsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schlagworte"
        Width="600"
        Height="380"
        MinWidth="520"
        MinHeight="340"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource LiftUpSubheading}"
                       Text="Schlagworte für Auswahl" Margin="0,0,0,6" />

            <TextBlock x:Name="CountText" Grid.Row="1" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" Margin="0,0,0,12" />

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Hinzufügen" Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Width="100" />
                <ComboBox x:Name="AddBox" IsEditable="True" Width="380"
                          ToolTip="Ein oder mehrere Schlagworte, mit Komma getrennt" />
            </StackPanel>

            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,8">
                <TextBlock Text="Entfernen" Style="{StaticResource LiftUpFieldLabel}"
                           VerticalAlignment="Center" Width="100" />
                <ComboBox x:Name="RemoveBox" IsEditable="True" Width="380"
                          ToolTip="Schlagworte der markierten Bilder, mit Komma getrennt" />
            </StackPanel>

            <TextBlock Grid.Row="4" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap"
                       Text="Beide Felder dürfen leer bleiben. Mehrere Schlagworte mit Komma trennen; vorhandene Vorschläge lassen sich aus der Liste wählen." />

            <TextBlock x:Name="HintText" Grid.Row="5" Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap" VerticalAlignment="Bottom" Margin="0,8,0,0" />

            <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button Content="Übernehmen" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}"
                        Margin="0" Click="OnApplyClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
