<UserControl x:Class="LiftUp.App.Views.PdfView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource LiftUpCard}" Padding="12" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="Projekt" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="ProjectBox" Width="240" Margin="0,0,14,0"
                              DisplayMemberPath="DisplayText" SelectionChanged="OnProjectChanged" />

                    <TextBlock Text="Typ" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="TypeFilterBox" Width="140" Margin="0,0,14,0"
                              DisplayMemberPath="Display" SelectionChanged="OnTypeChanged" />

                    <TextBlock Text="Vorlage" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="TemplateBox" Width="190" DisplayMemberPath="Name" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                    <TextBlock Text="Format" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="FormatBox" Width="80" Margin="0,0,12,0" />

                    <TextBlock Text="Ausrichtung" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <ComboBox x:Name="OrientationBox" Width="110" Margin="0,0,12,0" />

                    <TextBlock Text="Rand (mm)" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                    <TextBox x:Name="MarginBox" Width="60" Text="15" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="Vorschau" Click="OnPreviewClick" />
                    <Button Content="PDF erzeugen" Style="{StaticResource LiftUpPrimaryButton}" Click="OnCreateClick" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="440" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LiftUpCard}" Margin="0,0,10,0">
                <wv2:WebView2 x:Name="PreviewBrowser" />
            </Border>

            <Border Grid.Column="1" Style="{StaticResource LiftUpCard}" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Erzeugte Dokumente" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,8" />

                    <DataGrid x:Name="DocumentsGrid" Grid.Row="1" IsReadOnly="True" SelectionChanged="OnDocumentSelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Datei" Binding="{Binding FileName}" Width="*" />
                            <DataGridTextColumn Header="Vorlage" Binding="{Binding TemplateName}" Width="110" />
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="70" />
                            <DataGridTextColumn Header="Erstellt" Binding="{Binding CreatedText}" Width="110" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button x:Name="OpenButton" Content="Öffnen" Click="OnOpenClick" IsEnabled="False" />
                        <Button x:Name="FolderButton" Content="Im Ordner zeigen" Click="OnShowFolderClick" IsEnabled="False" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="2" Style="{StaticResource LiftUpMutedText}" Margin="2,8,0,0" />
    </Grid>
</UserControl>
