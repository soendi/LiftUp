<Window x:Class="LiftUp.App.Views.DocumentTypesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dokumenttypen"
        Width="460"
        Height="440"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource LiftUpSubheading}" Text="Dokumenttypen" Margin="0,0,0,10" />

            <DataGrid x:Name="TypesGrid" Grid.Row="1" IsReadOnly="True" SelectionChanged="OnSelectionChanged">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                    <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="100" />
                </DataGrid.Columns>
            </DataGrid>

            <StackPanel Grid.Row="2" Margin="0,10,0,0">
                <TextBlock Text="Name" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="NameBox" />
            </StackPanel>

            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                <TextBlock x:Name="InfoText" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap" MinHeight="32" />

                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Hinzufügen" Style="{StaticResource LiftUpPrimaryButton}" Click="OnAddClick" />
                    <Button Content="Umbenennen" Click="OnRenameClick" />
                    <Button x:Name="ArchiveButton" Content="Archivieren" Click="OnArchiveClick" />
                    <Button Content="Schließen" Margin="0" Click="OnCloseClick" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
