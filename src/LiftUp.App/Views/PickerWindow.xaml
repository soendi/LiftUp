<Window x:Class="LiftUp.App.Views.PickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Einfügen"
        Width="520"
        Height="440"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Border Margin="16" Style="{StaticResource LiftUpCard}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="HeadingText" Grid.Row="0" Style="{StaticResource LiftUpSubheading}" Margin="0,0,0,10" />

            <ListBox x:Name="ItemList" Grid.Row="1" MouseDoubleClick="OnDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" Width="220" />
                            <TextBlock Text="{Binding Detail}" Style="{StaticResource LiftUpMutedText}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                <Button Content="Abbrechen" Click="OnCancelClick" />
                <Button x:Name="ConfirmButton" Content="Einfügen" IsDefault="True" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnInsertClick" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
