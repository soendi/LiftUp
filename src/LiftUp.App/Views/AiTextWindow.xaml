<Window x:Class="LiftUp.App.Views.AiTextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KI-Vorschlag"
        Width="1000"
        Height="640"
        MinWidth="720"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource LiftUpBackground}">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock x:Name="HeadingText"
                       Text="KI-Vorschlag"
                       FontSize="16"
                       FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource LiftUpMutedText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"
                       Text="Links steht der Text aus dem Editor, rechts der Vorschlag der KI. Der Vorschlag lässt sich vor dem Übernehmen noch bearbeiten." />
        </StackPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LiftUpCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Ihr Text" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="UserBox"
                             Grid.Row="1"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             BorderThickness="0"
                             Background="Transparent" />
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource LiftUpCard}" Padding="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Vorschlag der KI" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,6" />
                    <TextBox x:Name="AiBox"
                             Grid.Row="1"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Abbrechen"
                    Click="OnCancelClick"
                    IsCancel="True"
                    Margin="0,0,8,0" />
            <Button Content="Text übernehmen"
                    Style="{StaticResource LiftUpPrimaryButton}"
                    Click="OnApplyClick"
                    IsDefault="True"
                    Margin="0" />
        </StackPanel>
    </Grid>
</Window>
