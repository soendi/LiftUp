<UserControl x:Class="LiftUp.App.Views.TemplatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource LiftUpCard}" Padding="10" Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="Vorlagen" Style="{StaticResource LiftUpFieldLabel}" Margin="0,0,0,8" />

                    <DataGrid x:Name="TemplatesGrid" Grid.Row="1" IsReadOnly="True" SelectionChanged="OnTemplateSelected">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*" />
                            <DataGridTextColumn Header="Version" Binding="{Binding VersionText}" Width="70" />
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusText}" Width="75" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Neue Vorlage" Click="OnNewClick" />
                        <Button x:Name="ToggleActiveButton" Content="Aktivieren" Click="OnToggleActiveClick" IsEnabled="False" />
                        <Button x:Name="DeleteButton" Content="Löschen" Click="OnDeleteClick" IsEnabled="False" Margin="0" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource LiftUpCard}" Padding="10">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Name" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                            <TextBox x:Name="NameBox" Width="220" Margin="0,0,14,0" />

                            <TextBlock Text="Dokumenttyp" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                            <ComboBox x:Name="TypeBox" Width="150" Margin="0,0,6,0" DisplayMemberPath="Name" />
                            <Button Content="Typen …" Margin="0,0,14,0" Click="OnManageTypesClick" />

                            <TextBlock Text="Version" VerticalAlignment="Center" Margin="0,0,6,0" Style="{StaticResource LiftUpFieldLabel}" />
                            <ComboBox x:Name="VersionBox" Width="120" DisplayMemberPath="VersionText" SelectionChanged="OnVersionSelected" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
                            <Button Content="Vorschau" Click="OnPreviewClick" />
                            <Button Content="Datei importieren …" Click="OnImportClick" ToolTip="Excel, CSV, HTML, Text oder Word als Vorlage übernehmen" />
                            <Button Content="Als neue Version speichern" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveClick" />
                        </StackPanel>

                        <Border x:Name="MissingBorder" Grid.Row="2" Style="{StaticResource LiftUpCard}"
                                Padding="10" Margin="0,0,0,8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel>
                                    <TextBlock x:Name="MissingTitle" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock x:Name="MissingText" Style="{StaticResource LiftUpMutedText}" TextWrapping="Wrap"
                                               Margin="0,4,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                            Margin="10,0,0,0">
                                    <Button x:Name="ReplaceImagesButton" Content="Bilder ersetzen …"
                                            Click="OnReplaceImagesClick" />
                                    <Button Content="Platzhalter entfernen" Click="OnRemoveMissingClick" Margin="0" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Je Blatt ein Reiter: „Deckblatt“ ist die Vorlagenversion, die übrigen Reiter
                             sind die Blätter mit Untertitel und HTML. Der Codebereich scrollt selbst. -->
                        <Grid Grid.Row="3" Height="380">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="300" />
                            </Grid.ColumnDefinitions>

                            <TabControl x:Name="SheetTabs" Grid.Column="0" Margin="0,0,10,0"
                                        SelectionChanged="OnSheetTabChanged">
                                <TabItem x:Name="CoverTab" Header="Deckblatt">
                                    <TextBox x:Name="HtmlBox" Margin="2"
                                             AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas" FontSize="12" MinHeight="240" />
                                </TabItem>
                            </TabControl>

                            <Border Grid.Column="1" BorderBrush="{StaticResource LiftUpBorder}" BorderThickness="1">
                                <wv2:WebView2 x:Name="PreviewBrowser" />
                            </Border>
                        </Grid>

                        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="Blatt hinzufügen" Click="OnAddSectionClick" />
                            <Button x:Name="RemoveSectionButton" Content="Blatt entfernen" Click="OnRemoveSectionClick" />
                            <Button x:Name="MoveUpButton" Content="Nach oben" Click="OnMoveSectionUpClick" />
                            <Button x:Name="MoveDownButton" Content="Nach unten" Click="OnMoveSectionDownClick" />
                            <Button Content="Blätter speichern" Style="{StaticResource LiftUpPrimaryButton}" Margin="0" Click="OnSaveSectionsClick" />
                        </StackPanel>

                        <Expander Grid.Row="5" Header="Platzhalter (Doppelklick fügt ins gewählte Blatt ein)"
                                  Margin="0,8,0,0" IsExpanded="False">
                            <ListBox x:Name="PlaceholderList" Height="120" MouseDoubleClick="OnPlaceholderDoubleClick">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Token}" FontFamily="Consolas" Width="220" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource LiftUpMutedText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Expander>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>

        <TextBlock x:Name="InfoText" Grid.Row="1" Style="{StaticResource LiftUpMutedText}" Margin="2,8,0,0" />

        <Popup x:Name="ImagePopup" PlacementTarget="{Binding ElementName=HtmlBox}" Placement="Relative"
               StaysOpen="True" AllowsTransparency="True">
            <Border Background="White" BorderBrush="{StaticResource LiftUpBorder}" BorderThickness="1"
                    CornerRadius="4" Padding="4">
                <ListBox x:Name="ImageList" BorderThickness="0" Width="340" MaxHeight="260"
                         PreviewMouseLeftButtonUp="OnImageListClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <Border Width="44" Height="32" Background="#F4F6F9" Margin="0,0,8,0"
                                        VerticalAlignment="Center">
                                    <Image Source="{Binding Preview}" Stretch="Uniform" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource LiftUpMutedText}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Popup>
    </Grid>
</UserControl>
