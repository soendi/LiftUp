<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RootNamespace>LiftUp.Core</RootNamespace>
    <AssemblyName>LiftUp.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- DPAPI: bindet die Cloud-Tokens an den angemeldeten Windows-Benutzer. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.10" />
    <!-- Direkter Zugriff auf die zentrale PostgreSQL-Datenbank (Abgleich). -->
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>
</Project>
